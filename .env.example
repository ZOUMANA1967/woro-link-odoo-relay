# Copiez ce fichier en ".env" et remplissez avec vos vraies informations.
# Ne partagez jamais ce fichier rempli, ne le collez jamais dans un chat.

ODOO_URL=https://votre-entreprise.odoo.com
ODOO_DB=votre-entreprise
ODOO_USERNAME=votre-email@exemple.com
ODOO_API_KEY=collez-ici-la-cle-generee-dans-odoo

# Toutes les combien de minutes le relais recopie les produits depuis Odoo.
# 60 = une copie par heure. Vous pouvez mettre 1440 pour une fois par jour.
SYNC_INTERVAL_MINUTES=60
